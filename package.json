{
  "name": "@rtkelly-labs/mermaid-toolkit",
  "version": "0.1.0-alpha.0",
  "description": "Lightweight MDX & static SVG renderer for Mermaid powered by Pele with ASCII art fallbacks",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --tsconfig tsconfig.build.json",
    "prepare": "pnpm build",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch --tsconfig tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:fixtures": "vitest run tests/fixtures.test.ts",
    "bench": "vitest bench --run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check:exports": "publint --strict && attw --pack .",
    "size": "size-limit",
    "examples": "tsx examples/index.ts",
    "site:build": "tsx site/builder.ts",
    "site:preview": "tsx site/preview.ts",
    "ci": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm check:exports && pnpm size",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "mermaid",
    "pele",
    "mdx",
    "remark",
    "rehype",
    "svg",
    "ascii",
    "ascii-art",
    "diagram",
    "flowchart",
    "text-diagram",
    "markdown",
    "llms.txt"
  ],
  "author": "Ryan Kelly",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rtkelly-labs/mermaid-toolkit.git"
  },
  "homepage": "https://github.com/rtkelly-labs/mermaid-toolkit#readme",
  "bugs": {
    "url": "https://github.com/rtkelly-labs/mermaid-toolkit/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.3",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "4.0.17",
    "publint": "^0.3.21",
    "size-limit": "^12.1.0",
    "tsup": "^8.3.5",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^4.0.17"
  },
  "size-limit": [
    {
      "name": "ESM (import)",
      "path": "dist/index.mjs",
      "limit": "6 kB",
      "ignore": [
        "pele"
      ]
    },
    {
      "name": "CJS (require)",
      "path": "dist/index.js",
      "limit": "6 kB",
      "ignore": [
        "pele"
      ]
    }
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "pele": "^1.10.0"
  }
}
